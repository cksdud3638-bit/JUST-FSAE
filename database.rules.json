{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "just": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('members').child(auth.uid).val() === true",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('members').child(auth.uid).val() === true"
    }
  }
}
